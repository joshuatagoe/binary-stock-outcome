*.db
*.db-shm
*.db-wal
.*.db-litestream/

# make dev's local chain, store, keys and program copy (D74)
.local/

# Local environment (.env.example is the committed template)
.env
.env*.local

# Installed packages
node_modules/

# Build and test output
dist/
test-results/
playwright-report/

# Rust build output (in a Linux checkout; Windows checkouts build on WSL's disk, P11)
/target/
