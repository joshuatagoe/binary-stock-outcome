# Cloudflare Pages sends these on every path (P17). noindex keeps the demo out of search results; there is no
# robots.txt block, since Google never sees a noindex on a page robots.txt blocks (WP.03).
# The page loads only our own files and Google Fonts, and talks only to Solana devnet's public RPC.
/*
  X-Robots-Tag: noindex
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self' https://api.devnet.solana.com wss://api.devnet.solana.com; img-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
