{
  "name": "meridian",
  "private": true,
  "type": "module",
  "description": "Binary stock-outcome contracts on Solana devnet (Gauntlet x Peak6 Meridian)",
  "engines": {
    "node": "24.21.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "clients/ts"
  ],
  "scripts": {
    "verify": "node scripts/verify/index.mjs",
    "push": "node scripts/push.mjs",
    "client": "node scripts/client/generate.mjs"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "1.5.6",
    "@codama/renderers-js": "2.5.0",
    "@mermaid-js/mermaid-cli": "11.17.0",
    "@types/node": "24.19.0",
    "codama": "1.11.0",
    "puppeteer": "25.12.0",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "puppeteer@25.12.0": true
  }
}
