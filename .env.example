# Meridian's secrets, by name only. Copy this file to .env and put the values there.
# .env is gitignored, and `npm run verify` fails if a value appears in this file (D17).
# Fly.io and Northflank hold their own copies as platform secrets. The admin and
# upgrade keys never leave the laptop (D92), so they aren't listed here.

# The backend's operator key: creates markets and settles; can't pause or override (A5). The 64 bytes of a key file,
# as [12,34,...] or in base58. Unset, the backend runs without the jobs that send (P34).
OPERATOR_SECRET_KEY=
# The market-making bot's trading key (D41).
BOT_SECRET_KEY=

# The second devnet RPC provider (D119). Public devnet needs no key.
ALCHEMY_API_KEY=

# The internal reference close, never displayed (D93).
TIINGO_API_KEY=

# Alerts by Telegram bot (D117).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# The watchdog's check-in URL (D118). M0 sends one test check-in.
HEALTHCHECKS_PING_URL=

# Optional: Litestream's continuous backup of the SQLite store to Cloudflare R2, with a key that reaches one
# bucket only (D124, P17). Leave these blank to keep it off; Fly.io's daily snapshots are the backup (D134).
# The account ID and the bucket's name make the address apps/backend/litestream.yml copies to.
R2_ACCOUNT_ID=
R2_BUCKET=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
